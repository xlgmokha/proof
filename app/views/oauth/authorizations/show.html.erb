<div class="container">
  <div class="row">
    <div class="col">
      <h1 class="title"><%= t('.title') %></h1>

      <p><%= t('.authorize_prompt_html', name: @client.name) %></p>
      <%= form_for :authorization, url: oauth_authorizations_path, method: :post, data: { turbo: false } do |form| %>
        <%= form.button t('.authorize'), type: 'submit', class: 'btn btn-primary', data: { turbo_submits_with: t('loading') } %>
        <%= form.button t('.deny'), type: 'submit', name: 'deny', value: '1', class: 'btn btn-secondary' %>
      <% end %>
    </div>
  </div>
</div>
